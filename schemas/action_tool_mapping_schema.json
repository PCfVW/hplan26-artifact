{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcp-python-ingestion/schemas/action_tool_mapping_schema.json",
  "title": "Action-to-Tool Mapping Configuration",
  "description": "Schema for GTPyhop action to MCP server tool mappings",
  "type": "object",
  "required": ["domain", "mappings"],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "Domain name (e.g., 'drug_target_discovery')"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Configuration version (semantic versioning)"
    },
    "verify_bijection": {
      "type": "boolean",
      "default": false,
      "description": "If true, verify 1:1 action-to-tool correspondence"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "server", "tool"],
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^a_[a-z_]+$",
            "description": "GTPyhop action name (must start with 'a_')"
          },
          "server": {
            "type": "string",
            "minLength": 1,
            "description": "MCP server name (e.g., 'opentargets-server')"
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "description": "MCP tool name on the server"
          },
          "parameter_mapping": {
            "type": "object",
            "patternProperties": {
              "^[0-9]+$": {
                "type": "string"
              }
            },
            "description": "Maps action parameter indices to tool parameter names"
          },
          "output_extractors": {
            "type": "object",
            "patternProperties": {
              "^[a-z_]+$": {
                "type": "string"
              }
            },
            "description": "Maps context variables to JSONPath expressions"
          }
        }
      }
    }
  }
}

